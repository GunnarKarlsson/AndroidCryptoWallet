<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Wallet traffic is HTTPS only. Custom RPCs in Settings must be https://. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
