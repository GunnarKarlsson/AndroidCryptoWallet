<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Secrets (BIP-39 mnemonic + passphrase) and wallet DB must not leave the device.
      Prefs files: bitcoin_mnemonic, ethereum_mnemonic.
    -->
    <cloud-backup>
        <exclude domain="sharedpref" path="bitcoin_mnemonic" />
        <exclude domain="sharedpref" path="ethereum_mnemonic" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="wallet.db" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bitcoin_mnemonic" />
        <exclude domain="sharedpref" path="ethereum_mnemonic" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="wallet.db" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
